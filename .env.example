# Placeholders only. Real values go in the environment's secret store (G05),
# never in this file, the repo, chat, logs or rendered media.

# Runtime mode. Only "mock" is allowed while gates G01-G06 are BLOCKED.
DESK_MODE=mock

# PostgreSQL 17.11 connection (psycopg 3 URL form).
DESK_DATABASE_URL=postgresql+psycopg://desk:CHANGE_ME@localhost:5432/desk
# Tests only: an admin URL; each test run creates and drops its own throwaway database.
DESK_TEST_DATABASE_URL=

# WhatsApp Cloud API v26.0 — BLOCKED G02. Leave empty.
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Model adapter — BLOCKED G01. Leave empty.
DESK_MODEL_ADAPTER=mock

# Market data feed — BLOCKED G03. Leave as fixture.
DESK_FEED_ADAPTER=fixture

# Telegram TEST transport (T1) — owner's PC only, test-only, until the G05 secret store.
# Never commit a real token. Live mode also needs the Bot API version pinned in code.
DESK_TELEGRAM_LIVE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# B02: encrypt transport ids (wa_id, Telegram chat id) at rest. 0 = off (default).
# Key = urlsafe base64 of 64 random bytes; env var only until the G05 key store. Never commit it.
DESK_ENCRYPT_SENDERS=0
DESK_SENDER_KEY=
# B06 rotation only: the new key for `python -m desk senders rotate`; empty otherwise.
DESK_SENDER_KEY_NEW=
